// Windows version resource for ManiaReplayAnalyzer.exe.
// Gives Explorer / SmartScreen heuristics proper product metadata.
#include "winres.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ManiaReplayAnalyzer project"
            VALUE "FileDescription", "osu!mania Replay Analyzer"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "ManiaReplayAnalyzer"
            VALUE "LegalCopyright", "Freeware"
            VALUE "OriginalFilename", "ManiaReplayAnalyzer.exe"
            VALUE "ProductName", "osu!mania Replay Analyzer"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
