# Generates RCDATA resources + a lookup header for everything under
# FRONTEND_DIST, mirroring what app/embedded_assets.cpp expects.
function(mra_mime_for_path PATH_OUT_VAR FILE)
  set(MIME application/octet-stream)
  if(FILE MATCHES "\\.(html|htm)$")
    set(MIME text/html)
  elseif(FILE MATCHES "\\.(js|mjs)$")
    set(MIME text/javascript)
  elseif(FILE MATCHES "\\.css$")
    set(MIME text/css)
  elseif(FILE MATCHES "\\.svg$")
    set(MIME image/svg+xml)
  elseif(FILE MATCHES "\\.png$")
    set(MIME image/png)
  elseif(FILE MATCHES "\\.(jpg|jpeg)$")
    set(MIME image/jpeg)
  elseif(FILE MATCHES "\\.webp$")
    set(MIME image/webp)
  elseif(FILE MATCHES "\\.gif$")
    set(MIME image/gif)
  elseif(FILE MATCHES "\\.bmp$")
    set(MIME image/bmp)
  elseif(FILE MATCHES "\\.ico$")
    set(MIME image/x-icon)
  elseif(FILE MATCHES "\\.woff2$")
    set(MIME font/woff2)
  elseif(FILE MATCHES "\\.woff$")
    set(MIME font/woff)
  elseif(FILE MATCHES "\\.(json|map)$")
    set(MIME application/json)
  endif()
  set(${PATH_OUT_VAR} "${MIME}" PARENT_SCOPE)
endfunction()

function(mra_generate_embedded FRONTEND_DIST OUT_DIR)
  file(MAKE_DIRECTORY "${OUT_DIR}")
  if(NOT EXISTS "${FRONTEND_DIST}")
    file(WRITE "${OUT_DIR}/embedded_files.h"
         "#pragma once\n#define MANIA_HAS_EMBEDDED 0\n")
    file(WRITE "${OUT_DIR}/mra_resources.rc"
         "// no embedded frontend resources\n")
    return()
  endif()

  file(GLOB_RECURSE DIST_FILES "${FRONTEND_DIST}/*")
  set(RC_LINES "// generated by embed_frontend.cmake\n#include \"winres.h\"\n")
  set(MAP_ENTRIES)
  set(INDEX 0)
  foreach(FILE ${DIST_FILES})
    file(RELATIVE_PATH REL "${FRONTEND_DIST}" "${FILE}")
    string(REPLACE "\\" "/" REL_POSIX "${REL}")
    math(EXPR ID "100 + ${INDEX}")
    list(APPEND RC_LINES "${ID} RCDATA \"${FILE}\"")
    mra_mime_for_path(MIME "${REL_POSIX}")
    list(APPEND MAP_ENTRIES
         "  {\"${REL_POSIX}\", ${ID}, \"${MIME}\"},")
    math(EXPR INDEX "${INDEX} + 1")
  endforeach()

  string(JOIN "\n" RC_TEXT ${RC_LINES})
  file(WRITE "${OUT_DIR}/mra_resources.rc" "${RC_TEXT}\n")

  string(JOIN "\n" MAP_TEXT ${MAP_ENTRIES})
  string(CONCAT HEADER_CONTENT
         "#pragma once\n#include <cstring>\n"
         "#define MANIA_HAS_EMBEDDED ${INDEX}\n"
         "struct EmbeddedFileEntry { const char* path; int resourceId; const char* mime; };\n"
         "inline const EmbeddedFileEntry kEmbeddedFiles[] = {\n"
         "${MAP_TEXT}\n"
         "};\n"
         "inline const EmbeddedFileEntry* embeddedFileFor(const char* path) {\n"
         "  for (const auto& f : kEmbeddedFiles)\n"
         "    if (strcmp(f.path, path) == 0) return &f;\n"
         "  return nullptr;\n"
         "}\n")
  file(WRITE "${OUT_DIR}/embedded_files.h" "${HEADER_CONTENT}")
endfunction()